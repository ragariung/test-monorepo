{
  "name": "insurance-backend-mvp",
  "version": "0.1.0",
  "description": "PRAXIS Insurance MVP backend (NestJS + Prisma + PostgreSQL)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
