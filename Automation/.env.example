# Reference only - not consumed by docker-compose.yml (same pattern as
# Backends/.env.example and Frontends/.env.example: this repo hardcodes these
# as literal placeholder values directly in docker-compose.yml's `environment:`
# block, e.g. JWT_SECRET: change-me-in-production). Documented here so it's
# clear what matters if you ever run n8n outside this compose file.
#
# No N8N_BASIC_AUTH_* vars: deprecated/non-functional in n8n v2 (this project
# pins n8nio/n8n:2.37.10), confirmed live. n8n v2 uses its own built-in user
# accounts instead - see Automation/README.md's "Running it" section.

# Encrypts n8n's stored credential values (e.g. the Gemini API key you'll add
# in the n8n UI). Must be a FIXED value, not left to auto-generate, and must
# match across every machine you want to import workflows/credentials onto -
# see Automation/README.md.
N8N_ENCRYPTION_KEY=change-me-in-production-use-a-real-random-key

GENERIC_TIMEZONE=Asia/Jakarta
